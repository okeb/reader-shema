NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=https://www.shemaproject.org

# --- Spec 22 : compte + sync multi-appareil (serveur runtime) ---
# URL d'auth Neon (Managed Better Auth) — Console Neon : Project > Branch > Auth > Configuration.
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth
# Secret de signature des cookies de session (min 32 caractères) — `openssl rand -base64 32`.
NEON_AUTH_COOKIE_SECRET=
# Connexion à la base Neon Postgres (même projet que l'auth), région UE si possible.
DATABASE_URL=postgres://user:password@host.neon.tech/dbname?sslmode=require