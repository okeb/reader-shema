# Côté client (inliné au build). Sur Vercel : scope Production = domaine fixe
# (ex. https://reader.shemaproject.org), scope Preview = https://$VERCEL_URL (interpolé par
# Vercel à chaque preview) pour que le client appelle l'API auth de SON déploiement.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=https://www.shemaproject.org

# --- Spec 26 : auth self-hosted Better Auth + e-mails transactionnels (serveur runtime) ---
# Secret de signature des cookies de session Better Auth (min 32 caractères) — `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# URL de base servie de l'app (baseURL Better Auth). En prod = https://reader.shemaproject.org.
# Sur Vercel, laissée vide pour les previews : `lib/auth/server.ts` dérive `baseURL` + `trustedOrigins`
# de `VERCEL_URL` (injecté par Vercel) automatiquement — pas besoin de la poser par preview.
BETTER_AUTH_URL=http://localhost:3000
# Connexion à la base Neon Postgres — DOIT être l'endpoint POOLED (-pooler) pour pg.Pool
# (le driver `neon()` HTTP de neon-client.ts l'accepte aussi). Région eu-west-2 (AWS Londres).
# Ex : postgres://user:password@ep-xxx-pooler.eu-west-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=
# Clé API Resend (e-mails transactionnels : vérification, mot de passe oublié, lien magique).
# Optionnelle en dev : si absente, `sendEmail` no-op (console.warn) sans planter les flux auth.
RESEND_API_KEY=